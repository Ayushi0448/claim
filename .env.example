# Copy to .env and adjust. Never commit a real .env — it is in .gitignore.
# Every value below has a working default; the system runs with an empty file.

# --- Policy source --------------------------------------------------------
POLICY_PDF_PATH=data/policy/USGIC-CSCIndividualHealthInsurance_2017-2018.pdf
POLICY_SOURCE_NAME=USGIC-CSC-Individual-Health-Insurance.pdf
POLICY_ID=UNIHLIP18004V011718
INDEX_DIR=data/index

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
PORT=8000
# Comma-separated origins, or * for any. Set this to your deployed frontend
# origin in production rather than leaving it open.
CORS_ORIGINS=*
REQUEST_TIMEOUT_S=60
MAX_REQUEST_BYTES=256000

# --- Frontend -------------------------------------------------------------
# Point the Streamlit app at a deployed backend. Leave empty to run the engine
# in-process (which is how it works on Streamlit Community Cloud standalone).
API_BASE_URL=
# Streamlit's per-request budget for POST /analyze. Raise it when the backend
# runs a local LLM (ollama), which is far slower than a hosted endpoint.
UI_ANALYZE_TIMEOUT_S=120

# --- Retrieval tuning -----------------------------------------------------
DENSE_TOP_K=12
BM25_TOP_K=12
FUSION_TOP_K=16
RERANK_TOP_K=6
# Evidence guaranteed to survive from each dimension's own ranking.
PER_DIMENSION_K=3
# Reciprocal Rank Fusion smoothing constant.
RRF_K=60
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0
MIN_RERANK_SCORE=0.12

# --- Chunking -------------------------------------------------------------
MAX_CHUNK_CHARS=1600
MIN_CHUNK_CHARS=180
CHUNK_OVERLAP_CHARS=160

# --- Model backends -------------------------------------------------------
# auto = use the transformer if its weights load, otherwise the offline
# implementation. Set explicitly to pin a backend in production.
#   EMBEDDING_BACKEND: auto | sentence_transformer | lsa
#   RERANKER_BACKEND : auto | cross_encoder | lexical
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LSA_EMBEDDING_DIM=192
RERANKER_BACKEND=auto
RERANKER_MODEL=BAAI/bge-reranker-base

# --- LLM (entirely optional) ----------------------------------------------
# The LLM never decides admissibility: it polishes the summary, proposes extra
# retrieval phrasings, and adds an advisory second opinion during validation.
# Decisions are identical with it off, which is what keeps evaluation
# reproducible. Any OpenAI-compatible endpoint works.
#   LLM_PROVIDER: none | openai | openrouter | groq | together | deepseek | ollama
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=1

# --- Decision thresholds --------------------------------------------------
# An affirmative decision below this confidence is downgraded to NEEDS_REVIEW.
ABSTAIN_BELOW_CONFIDENCE=0.45
MAX_VALIDATION_REVISIONS=1
STRICT_CITATION_MODE=true
